---
import Layout from "@layouts/Layout.astro";
import Card from "@components/Card.astro";
import Intro from "@components/Intro.astro";
import SkillSet from "@components/SkillSet.astro";
import Experience from "@components/Experience.astro";
import Projects from "@components/Projects.astro";
import Credentials from "@components/Credentials.astro";
import Profile from "@assets/profile.json";
---

<Layout title={Profile.intro.name + " Online Resume"}>
	<main id="top">
		<Intro />
		<Card id="skills" title="Skills"><SkillSet /></Card>
		<Card id="experience" title="Experience"><Experience /></Card>
		<Card id="selected-work" title="Selected Work"><Projects /></Card>
		<Card id="education" title="Education & Certifications"
			><Credentials /></Card
		>
	</main>
</Layout>

<style></style>
