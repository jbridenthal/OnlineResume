---
import ProfileImage from "@assets/images/profile.png";
import Profile from "@assets/profile.json";
---

<section class="wrapper">
    <div class="introContent">
        <div class="leftSide">
            <img src={ProfileImage.src} alt={Profile.intro.name} />
            <section class="socials">
                {
                    Profile.intro.socials.map((social) => (
                        <a
                            href={social.link}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {social.name}
                        </a>
                    ))
                }
            </section>
        </div>
        <div class="rightSide">
            <h1 class="name">{Profile.intro.name}</h1>
            <p class="intro">
                {Profile.intro.blurb}
            </p>
        </div>
    </div>
</section>

<style>
    img {
        border-radius: 50%;
        padding: 15px;
        width: 150px;
        margin-left: 3rem;
    }

    .name {
        font-size: 3rem;
        margin: 0;
    }

    .intro {
        font-size: 1rem;
        margin-right: 2rem;
    }
    .leftSide {
        width: 325px;
        float: left;
        justify-content: center;
    }

    .rightSide {
        justify-content: center;
        margin-left: 1rem;
    }

    .introContent {
        width: 100%;
        overflow: hidden;
    }

    .socials {
        display: flex;
        justify-content: center;
        column-gap: 1em;
        flex-wrap: wrap;
    }

    @media (max-width: 600px) {
        .wrapper {
            display: block;
        }

        .leftSide {
            width: auto;
            float: none;
        }

        img {
            display: block;
            margin: 0 auto;
        }

        .rightSide {
            margin-left: 0;
            text-align: center;
        }

        .intro {
            margin-right: 0;
        }
    }
</style>
