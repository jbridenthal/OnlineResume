---
import ProfileImage from "@assets/images/profile.png";
import Profile from "@assets/profile.json";
---

<section class="wrapper hero">
    <div class="introContent">
        <div class="leftSide">
            <div class="portrait-frame">
                <img src={ProfileImage.src} alt={Profile.intro.name} />
            </div>
            <section class="socials">
                {
                    Profile.intro.socials.map((social) => (
                        <a
                            href={social.link}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {social.name}
                        </a>
                    ))
                }
            </section>
        </div>
        <div class="rightSide">
            <h1 class="name">{Profile.intro.name}</h1>
            <p class="role">Senior Software Engineer V</p>
            <p class="intro">
                {Profile.intro.blurb}
            </p>
        </div>
    </div>
</section>

<style>
    .hero {
        padding: 1rem 0 2rem;
    }

    .portrait-frame {
        width: 160px;
        height: 160px;
        margin: 0 auto 1rem;
        border: 2px solid var(--color-accent);
        border-radius: 50%;
        padding: 0.45rem;
    }

    img {
        border-radius: 50%;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .name {
        font-size: 2.5rem;
        margin: 0;
    }

    .role {
        color: var(--color-link);
        font-size: var(--font-size-lg);
        margin: 0.35rem 0 1rem;
    }

    .intro {
        font-size: 1rem;
        margin-right: 2rem;
    }

    .leftSide {
        width: 280px;
        justify-content: center;
    }

    .rightSide {
        flex: 1;
        justify-content: center;
    }

    .introContent {
        display: flex;
        align-items: center;
        gap: 2.5rem;
        width: 100%;
        overflow: hidden;
    }

    .socials {
        display: flex;
        justify-content: center;
        column-gap: 1em;
        flex-wrap: wrap;
    }

    @media (max-width: 600px) {
        .wrapper {
            display: block;
        }

        .leftSide {
            width: auto;
            float: none;
        }

        .introContent {
            display: block;
        }

        img {
            display: block;
            margin: 0 auto;
        }

        .hero {
            padding: 1rem 0 2rem;
        }

        .rightSide {
            margin-left: 0;
            text-align: center;
        }

        .intro {
            margin-right: 0;
        }
    }
</style>
