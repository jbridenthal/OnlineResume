---
import "@styles/global.css";
export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<section class="card">
	<h2>{title}</h2>
	<div class="card-content">
		<slot />
	</div>
</section>

<style>
	.card {
		border: 0.2rem solid var(--color-hr);
		border-radius: 1rem;
		margin: 1.5rem;
		padding: 0.35em 0.75em 0.625em;
	}

	h2 {
		font-size: var(--font-size-lg);
		font-weight: normal;
		border: 0.2rem solid var(--color-hr);
		margin-left: 1em;
		margin-top: 0;
		margin-bottom: 0.5em;
		padding: 0.2em 0.8em;
		border-radius: 1rem;
		display: inline-block;
	}
	.card-content {
		display: flex;
		align-items: center;
		gap: 4em;
	}
</style>
